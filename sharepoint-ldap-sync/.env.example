# ============================================================
# SharePoint connection
# ============================================================

# Full URL of the SharePoint site (no trailing slash)
SP_SITE_URL=https://contoso.sharepoint.com/sites/MySite

# Azure AD application (client) ID and secret registered with
# Sites.ReadWrite.All (or Files.ReadWrite.All) permission
SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_SECRET=your-client-secret-here

# Path to the Excel file relative to the document library root.
# Example: "Shared Documents/HR/user_list.xlsx"
SP_FILE_PATH=Shared Documents/user_list.xlsx

# ============================================================
# LDAP / Active Directory
# ============================================================

LDAP_SERVER=dc01.contoso.com
LDAP_PORT=389
# Set to "true" to use LDAPS (port 636 recommended)
LDAP_USE_SSL=false

# Service account – use "DOMAIN\user" for NTLM or a full DN for SIMPLE bind
LDAP_BIND_DN=CONTOSO\svc-ldap-reader
LDAP_BIND_PASSWORD=your-ldap-password-here

# LDAP search base
LDAP_SEARCH_BASE=DC=contoso,DC=com

# Comma-separated list of LDAP attributes to retrieve.
# Leave blank to use the built-in default list (see config.py).
LDAP_ATTRIBUTES=displayName,mail,department,title,manager,telephoneNumber,userAccountControl,accountExpires,whenCreated,lastLogonTimestamp,memberOf

# ============================================================
# Excel layout (defaults match a standard layout)
# ============================================================

# Column letter that contains the usernames (sAMAccountName)
EXCEL_USERNAME_COLUMN=A

# Row number of the header row
EXCEL_HEADER_ROW=1

# First row that contains data
EXCEL_DATA_START_ROW=2
